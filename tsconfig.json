{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "types": ["jest"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "index.ts"]
}
