{
  "name": "chess-3d-mobile",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.28.3",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "deps:audit": "pnpm audit --prod --audit-level high",
    "audit:standards": "node scripts/audit.mjs",
    "test:parity": "node scripts/parity.mjs",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform android --platform ios --output-dir dist && node scripts/check-native-bundle.cjs",
    "build:android": "node scripts/build-android.cjs",
    "test": "jest --runInBand",
    "coverage": "jest --runInBand --coverage",
    "test:contrast": "node scripts/contrast.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/fiber": "9.8.2",
    "chess.js": "1.4.0",
    "expo": "58.0.19",
    "expo-asset": "58.0.18",
    "expo-file-system": "58.0.11",
    "expo-gl": "58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "three": "0.186.1",
    "expo-system-ui": "58.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@expo/cli": "58.1.15",
    "@react-three/test-renderer": "9.1.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "@types/three": "0.186.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.12",
    "typescript": "7.0.2",
    "test-renderer": "1.3.0"
  },
  "main": "index.ts"
}
